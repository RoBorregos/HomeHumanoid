# Base image for HomeHumanoid (cpu/cuda). Mirrors home2's pattern
# (see vendor/home2/docker/Dockerfile.ROS once the submodule is initialized)
# so vendored packages build under the same toolchain.
ARG ROS_DISTRO=jazzy
FROM ros:${ROS_DISTRO}-ros-base

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-colcon-common-extensions \
    python3-rosdep \
    python3-pip \
    git \
    ros-${ROS_DISTRO}-navigation2 \
    ros-${ROS_DISTRO}-nav2-bringup \
    ros-${ROS_DISTRO}-slam-toolbox \
    ros-${ROS_DISTRO}-ros-gz \
    ros-${ROS_DISTRO}-gz-ros2-control \
    ros-${ROS_DISTRO}-pointcloud-to-laserscan \
    ros-${ROS_DISTRO}-pcl-ros \
    ros-${ROS_DISTRO}-xacro \
    ros-${ROS_DISTRO}-rmw-cyclonedds-cpp \
    ros-${ROS_DISTRO}-nav2-regulated-pure-pursuit-controller \
    python3-pyqt5 \
    python3-numpy \
    python3-yaml \
    libeigen3-dev \
    libpcl-dev \
    cmake \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /ws

# The workspace (src/, vendor/, third_party/) is mounted as a volume in
# docker-compose; rosdep + colcon build are run manually inside the container
# (see README.md). The MID-360 driver and FAST-LIO build into the mounted
# third_party/lio_ws with third_party/fetch_lio.sh (no root needed), and
# unitree_sdk2 per third_party/README.md.

RUN rosdep init || true

SHELL ["/bin/bash", "-c"]
CMD ["bash"]
