# Base image for HomeHumanoid (cpu/cuda). Mirrors home2's pattern
# (see vendor/home2/docker/Dockerfile.ROS once the submodule is initialized)
# so vendored packages build under the same toolchain.
ARG ROS_DISTRO=jazzy
FROM ros:${ROS_DISTRO}-ros-base

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-colcon-common-extensions \
    python3-rosdep \
    python3-pip \
    git \
    ros-${ROS_DISTRO}-navigation2 \
    ros-${ROS_DISTRO}-nav2-bringup \
    ros-${ROS_DISTRO}-slam-toolbox \
    ros-${ROS_DISTRO}-ros-gz \
    ros-${ROS_DISTRO}-gz-ros2-control \
    ros-${ROS_DISTRO}-pointcloud-to-laserscan \
    ros-${ROS_DISTRO}-pcl-ros \
    ros-${ROS_DISTRO}-xacro \
    ros-${ROS_DISTRO}-rmw-cyclonedds-cpp \
    ros-${ROS_DISTRO}-nav2-regulated-pure-pursuit-controller \
    python3-pyqt5 \
    python3-numpy \
    python3-yaml \
    libeigen3-dev \
    libpcl-dev \
    cmake \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# unitree_sdk2 for g1_loco_bridge (real robot), at /usr/local where its
# CMake config is found; the same commit as third_party/unitree_sdk2.
ARG UNITREE_SDK2_COMMIT=8e1b927586712edd6a4c29d50dd52dff1e163439
RUN git clone https://github.com/unitreerobotics/unitree_sdk2.git /tmp/unitree_sdk2 \
    && git -C /tmp/unitree_sdk2 checkout ${UNITREE_SDK2_COMMIT} \
    && cmake -S /tmp/unitree_sdk2 -B /tmp/unitree_sdk2/build -DBUILD_EXAMPLES=OFF \
    && cmake --build /tmp/unitree_sdk2/build -j"$(nproc)" --target install \
    && ldconfig && rm -rf /tmp/unitree_sdk2

WORKDIR /ws

# The workspace (src/, vendor/, third_party/) is mounted as a volume in
# docker-compose; rosdep + colcon build are run manually inside the container
# (see README.md). The MID-360 driver and FAST-LIO build into the mounted
# third_party/lio_ws with third_party/fetch_lio.sh (no root needed), and
# unitree_sdk2 per third_party/README.md.

RUN rosdep init || true

SHELL ["/bin/bash", "-c"]
CMD ["bash"]
