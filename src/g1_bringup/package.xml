<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>g1_bringup</name>
  <version>0.0.1</version>
  <description>
    Real Unitree G1 bringup: robot_state_publisher, the head MID-360
    (livox_ros_driver2), g1_perception (crop, /scan, FAST-LIO odometry),
    g1_loco_bridge (cmd_vel -> LocoClient) and g1_navigation. UNTESTED ON
    HARDWARE (docs/plan.md, M5).
  </description>
  <maintainer email="a00841255@tec.mx">RoBorregos</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>g1_description</exec_depend>
  <exec_depend>g1_loco_bridge</exec_depend>
  <exec_depend>g1_perception</exec_depend>
  <exec_depend>g1_navigation</exec_depend>
  <!-- livox_ros_driver2 and fast_lio come from third_party/fetch_lio.sh
       (not rosdep-resolvable), so they are checked at launch time instead. -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
