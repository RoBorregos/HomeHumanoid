<?xml version="1.0"?>
<!--
  G1 wrapped for Gazebo Track A (kinematic virtual base — see docs/plan.md).
  Includes the vendored g1_29dof_raw.urdf (run scripts/vendor_g1.sh first —
  this file and meshes/ are gitignored, not committed) and adds:
    - A VelocityControl Gazebo plugin on `pelvis` (the model's actual root
      link; G1's URDF does not use `base_link`).
    - A gpu_lidar sensor on the existing `mid360_link` mount point, standing
      in for the real Livox MID-360 (2D-equivalent, not 3D-faithful — see
      docs/plan.md for why this is in-scope vs. the D435i, which isn't yet).
  The 29 leg/waist/arm joints are already locked to `fixed` by the vendor
  script (Track A has no actuation for them); this file does not touch them.

  No OdometryPublisher plugin: it was confirmed to stop publishing /sim/odom
  shortly after spawn on this Gazebo Harmonic build, even while the model
  kept moving under VelocityControl (see g1_base_bridge's module docstring).
  Odometry and the odom -> pelvis TF are published by g1_base_bridge instead,
  dead-reckoned from the same cmd_vel it relays — exact for this
  velocity-controlled kinematic base, and sidesteps the plugin entirely.
-->
<robot name="g1" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="g1_29dof_raw.urdf"/>

  <gazebo>
    <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
      <topic>/sim/cmd_vel</topic>
    </plugin>
  </gazebo>

  <!-- Velocity-driven, not physically simulated -->
  <gazebo reference="pelvis">
    <gravity>false</gravity>
  </gazebo>

  <!-- 2D-equivalent stand-in for the real Livox MID-360, full 360 deg sweep
       (unlike FRIDA's two-lidar setup, G1 has one lidar with no blind wedge
       to dodge). Mount point already exists in the vendored URDF.
       gpu_lidar (not the CPU "lidar" type): both sensor types need Ogre2's
       scene manager regardless, so there's no headless-rendering-avoidance
       benefit to the CPU variant on this build. The real fix for this
       Orin's headless EGL/GPU acceleration (libEGL: "failed to create dri2
       screen" under X11/Xvfb) is in sim_gz.launch.py: the gazebo process
       runs with DISPLAY unset and EGL_PLATFORM=surfaceless, which routes
       EGL to the Tegra GPU directly instead of through X11 — confirmed via
       `eglinfo -B` showing a working GBM/surfaceless platform on this box
       even though the X11 platform fails. -->
  <gazebo reference="mid360_link">
    <sensor name="mid360_scan" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <topic>/g1/mid360_scan</topic>
      <gz_frame_id>mid360_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.20</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
      <visualize>false</visualize>
    </sensor>
  </gazebo>
</robot>
