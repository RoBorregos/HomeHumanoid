<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>g1_sim_bringup</name>
  <version>0.0.1</version>
  <description>
    Orchestration launch files per simulation track: sim_gz.launch.py
    (Track A, Gazebo Harmonic) and sim_mujoco.launch.py (Track B, unitree_mujoco
    + unitree_rl_lab). See docs/plan.md.
  </description>
  <maintainer email="a00841255@tec.mx">RoBorregos</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>g1_description</exec_depend>
  <exec_depend>g1_base_bridge</exec_depend>
  <exec_depend>g1_nav_overlay</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
